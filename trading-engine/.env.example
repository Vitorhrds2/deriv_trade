# Deriv Application ID (necessário para a maioria das operações, incluindo streaming de dados públicos)
# Você pode criar um app_id em https://api.deriv.com/dashboard/
DERIV_APP_ID=1089

# Token de acesso OAuth 2.0 (necessário para transações como buy, sell, balance, etc.)
# Você pode gerar um token em https://app.deriv.com/account/api-token com a permissão "Trade" (e possivelmente "Read")
DERIV_API_TOKEN=

# Guardrails para execucao demo HFT. Nao autorizam conta real.
HFT_MAX_DEMO_LOSS_USD=50
HFT_MAX_SESSION_TRADES=30

# Guardrails para a estrategia demo imediata de ticks. Demo-only.
DEMO_TICK_SYMBOL=1HZ100V
DEMO_TICK_STAKE=1
DEMO_TICK_SIGNAL_STREAK=2
DEMO_TICK_MAX_TRADES=5
DEMO_TICK_MAX_DEMO_LOSS=10
DEMO_TICK_MAX_RUNTIME_SECONDS=900
