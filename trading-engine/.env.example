# Deriv Application ID (necessário para a maioria das operações, incluindo streaming de dados públicos)
# Você pode criar um app_id em https://api.deriv.com/dashboard/
DERIV_APP_ID=1089

# Token de acesso OAuth 2.0 (necessário para transações como buy, sell, balance, etc.)
# Você pode gerar um token em https://app.deriv.com/account/api-token com a permissão "Trade" (e possivelmente "Read")
DERIV_API_TOKEN=

# Jupiter Prediction API (venues/jupiter_prediction.py) -- exigida até para leitura.
# Gere em https://developers.jup.ag/portal
JUPITER_API_KEY=

# Chave privada da carteira Solana (venues/jupiter_execution.py) -- SÓ necessária pra EXECUTAR
# ordem de verdade (assinatura local de transação), não pra leitura. Formato: string base58,
# exatamente o que o Phantom exporta em Settings > Show Private Key (NUNCA a seed phrase de
# 12/24 palavras, é outra coisa). NUNCA compartilhe isto com ninguém, incluindo o agente/chat --
# preencha só aqui, direto no arquivo. Deixe em branco pra manter tudo em modo leitura/dry-run.
SOLANA_PRIVATE_KEY=

# RPC Solana usado pra submeter transação assinada. Opcional -- default é o RPC público
# (rate-limit baixo, ok pra teste). Trocar por um dedicado (Helius/QuickNode/etc) antes de
# operar de verdade com volume.
SOLANA_RPC_URL=
