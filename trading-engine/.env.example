# Deriv Application ID (necessário para a maioria das operações, incluindo streaming de dados públicos)
# Você pode criar um app_id em https://api.deriv.com/dashboard/
DERIV_APP_ID=1089

# Token de acesso OAuth 2.0 (necessário para transações como buy, sell, balance, etc.)
# Você pode gerar um token em https://app.deriv.com/account/api-token com a permissão "Trade" (e possivelmente "Read")
DERIV_API_TOKEN=

# Guardrails para execucao demo HFT. Nao autorizam conta real.
HFT_MAX_DEMO_LOSS_USD=50
HFT_MAX_SESSION_TRADES=30

# --- Capital REAL (early_sell_live.py --live) ---
# Token gerado NA CONTA REAL (nao na demo) em app.deriv.com/account/api-token,
# permissao "Trade". Mantido em var separada de DERIV_API_TOKEN de proposito, para
# nunca misturar acidentalmente com os bots de pesquisa/demo que usam essa outra var.
DERIV_API_TOKEN_REAL=
# Trava de confirmacao explicita -- sem isso == "YES", --live aborta antes de conectar
# mesmo se DERIV_API_TOKEN_REAL estiver preenchido.
CONFIRM_REAL_MONEY=

# Alertas por trade (telegram_alerts.py). Setup: fale com @BotFather (/newbot) para o
# token; mande 1 msg pro bot e acesse api.telegram.org/bot<TOKEN>/getUpdates para o chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Guardrails para a estrategia demo imediata de ticks. Demo-only.
DEMO_TICK_SYMBOL=1HZ100V
DEMO_TICK_STAKE=1
DEMO_TICK_SIGNAL_STREAK=2
DEMO_TICK_MAX_TRADES=5
DEMO_TICK_MAX_DEMO_LOSS=10
DEMO_TICK_MAX_RUNTIME_SECONDS=900

D107_EXPECTED_ACCOUNT_ID=
D107_SYMBOL=1HZ10V
D107_STAKE=1.00
D107_MAX_STAKE=10.00
D107_MULTIPLIER=400
D107_CANCELLATION=5m
D107_MAX_OPEN_POSITIONS=10
D107_MAX_DEPLOYED_PCT=0.20
D107_SESSION_LOSS_STOP_PCT=0.50
D107_MODE=canary
D107_CANARY_BUYS=5
D107_INTER_TRIAL_SECONDS=15
D107_BOUNDARY_BUFFER_SECONDS=15
D107_PORTFOLIO_SNAPSHOT_SECONDS=60
D107_OBSERVATION_LOG_SECONDS=300
D107_MIN_FREE_BYTES=104857600
D107_LOG_RAW_OBSERVATIONS=0
D107_UNRESOLVED_LOSS_ACTION=sell
D107_RESULTS_FILE=d107_rate_limit_winner_holding_results.jsonl
D107_STATE_FILE=d107_rate_limit_winner_holding_state.json
D107_AUTO_SELL_WINNERS=0
D107_WINNER_EXIT_MULTIPLE=3.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_CREDENTIAL_EXPIRATION=

POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
PRIVATE_KEY=
DEPOSIT_WALLET_ADDRESS=

JUPITER_API_KEY=
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_KEY_DEMO=
BINANCE_API_SECRET_DEMO=

WHALE_ALERT_API_KEY=
ETHERSCAN_API_KEY=
