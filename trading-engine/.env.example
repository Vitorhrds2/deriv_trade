# ==============================================================================
# TRADING ENGINE: QUANTITATIVE EXECUTION & MICROSTRUCTURE CONFIG (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' or '.env' inside 'trading-engine/':
#    cp .env.example .env.local
# 2. Both '.env' and '.env.*' are strictly ignored by .gitignore.
# 3. Use throwaway testnet credentials for testing venue connectors and simulation.
# 4. For Kalshi FIX testing without CFTC Rule 38 KYC, set KALSHI_ENV=mock.
#
# ==============================================================================

# ─── 1. HYPERLIQUID (H84: MEMPOOL GOSSIP & EIP-712 EXECUTION) ───────────────────
HYPERLIQUID_ENV=testnet                  # testnet | mainnet
HYPERLIQUID_REST_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
HYPERLIQUID_WALLET_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
HYPERLIQUID_PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a3f36088c
HYPERLIQUID_GOSSIP_PORT_TCP=4001
HYPERLIQUID_GOSSIP_PORT_UDP=4002
