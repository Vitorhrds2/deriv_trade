# ─── H86 Sui DeepBook Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values.
# To get these values, run: npx tsx h86_setup_wallet.ts

# Your Sui wallet private key (base64 encoded, from `sui keytool export`)
# Generate with: npx tsx h86_setup_wallet.ts
SUI_PRIVATE_KEY=

# Your Sui wallet address (starts with 0x...)
SUI_WALLET_ADDRESS=

# DeepBook V3 Balance Manager object ID (created by setup script)
# This is required to place orders on DeepBook
DEEPBOOK_BALANCE_MANAGER_ID=

# ─── Optional: Custom RPC (defaults to public mainnet) ────────────────
# SUI_RPC_URL=https://fullnode.mainnet.sui.io

# ─── DeepBook V3 Pool IDs (auto-discovered by scan script) ────────────
# Leave empty to auto-discover, or fill in if known:
# SUI_USDC_POOL_ID=
# SUI_USDT_POOL_ID=
